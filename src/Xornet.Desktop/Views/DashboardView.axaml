<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Xornet.Desktop.ViewModels"
             x:Class="Xornet.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16">
    <!-- Title -->
    <TextBlock Grid.Row="0"
               Text="Network Scanner"
               FontSize="24"
               FontWeight="Bold"
               Margin="0,0,0,16"/>

    <!-- Stats Cards -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,0,0,16">
      <Border Grid.Column="0" Background="#2D2D2D" CornerRadius="8" Padding="16" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="Total Devices" Foreground="#888" FontSize="12"/>
          <TextBlock Text="{Binding TotalDevices}" FontSize="24" FontWeight="Bold" Foreground="#FFF"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="#2D2D2D" CornerRadius="8" Padding="16" Margin="4,0,4,0">
        <StackPanel>
          <TextBlock Text="Online" Foreground="#888" FontSize="12"/>
          <TextBlock Text="{Binding OnlineDevices}" FontSize="24" FontWeight="Bold" Foreground="#4CAF50"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="#2D2D2D" CornerRadius="8" Padding="16" Margin="4,0,4,0">
        <StackPanel>
          <TextBlock Text="Killed" Foreground="#888" FontSize="12"/>
          <TextBlock Text="{Binding KilledDevices}" FontSize="24" FontWeight="Bold" Foreground="#F44336"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Background="#2D2D2D" CornerRadius="8" Padding="16" Margin="8,0,0,0">
        <StackPanel>
          <TextBlock Text="Status" Foreground="#888" FontSize="12"/>
          <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="Bold" Foreground="#2196F3"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Toolbar -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBox Grid.Column="0"
               PlaceholderText="Search devices..."
               Text="{Binding SearchText}"
               VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Scan"
                Command="{Binding ScanCommand}"
                IsEnabled="{Binding !IsScanning}"/>
        <Button Content="Kill"
                Command="{Binding KillCommand}"/>
        <Button Content="Kill All"
                Command="{Binding KillAllCommand}"/>
        <Button Content="Restore"
                Command="{Binding RestoreCommand}"/>
        <Button Content="Restore All"
                Command="{Binding RestoreAllCommand}"/>
      </StackPanel>
    </Grid>

    <!-- Device List -->
    <Border Grid.Row="3" Background="#1E1E1E" CornerRadius="8">
      <ListBox ItemsSource="{Binding Clients}"
               SelectedItem="{Binding SelectedClient}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="120,140,150,120,60,60">
              <TextBlock Grid.Column="0" Text="{Binding IpAddress}" Foreground="#FFF"/>
              <TextBlock Grid.Column="1" Text="{Binding MacAddress}" Foreground="#CCC"/>
              <TextBlock Grid.Column="2" Text="{Binding Hostname}" Foreground="#CCC"/>
              <TextBlock Grid.Column="3" Text="{Binding Vendor}" Foreground="#888" FontSize="11"/>
              <TextBlock Grid.Column="4" Text="{Binding IsOnline}"/>
              <TextBlock Grid.Column="5" Text="{Binding IsKilled}" Foreground="#F44336"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</UserControl>
