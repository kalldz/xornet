<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Xornet.Desktop.ViewModels"
        xmlns:views="clr-namespace:Xornet.Desktop.Views"
        x:Class="Xornet.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Xornet - Network Commander"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600">

  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#CCC"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#3D3D3D"/>
      <Setter Property="Foreground" Value="#FFF"/>
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#0078D4"/>
      <Setter Property="Foreground" Value="#FFF"/>
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="220,*">
    <!-- Sidebar -->
    <Border Grid.Column="0" Background="#252526">
      <Grid RowDefinitions="Auto,*,Auto">
        <!-- Logo -->
        <StackPanel Grid.Row="0" Margin="16,20,16,16">
          <TextBlock Text="XORNET" FontSize="20" FontWeight="Bold" Foreground="#0078D4"/>
          <TextBlock Text="Network Commander" FontSize="11" Foreground="#888" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Navigation -->
        <StackPanel Grid.Row="1" Margin="8,0">
          <Button Classes="nav"
                  Content="&#x1F4BB; Dashboard"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="Dashboard"/>
          <Button Classes="nav"
                  Content="&#x1F6E1; Shield"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="Shield"
                  Margin="0,4,0,0"/>
          <Button Classes="nav"
                  Content="&#x1F50D; Sniffer"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="Sniffer"
                  Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Status -->
        <StackPanel Grid.Row="2" Margin="16">
          <TextBlock Text="{Binding AdapterName}" FontSize="11" Foreground="#888" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding DeviceCount, StringFormat='{}{0} devices'}" FontSize="11" Foreground="#666" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Content -->
    <Border Grid.Column="1" Background="#1E1E1E">
      <ContentControl Content="{Binding CurrentView}" />
    </Border>
  </Grid>
</Window>
